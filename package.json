{
  "name": "lumen-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Lumen UI - 基于 Vue 3 的轻量级组件库",
  "author": "Lumen UI Team",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lumen/docs dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:tokens": "pnpm --filter @lumen/tokens build",
    "build:components": "pnpm --filter @lumen/components build",
    "build:doc": "pnpm --filter @lumen/docs build",
    "test": "pnpm -r test",
    "lint": "eslint \"packages/**/*.{ts,vue}\" \"docs/src/**/*.{ts,vue}\"",
    "lint:fix": "pnpm lint -- --fix",
    "lint:style": "stylelint \"packages/**/*.{scss,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,jsx,json,md,scss,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,jsx,json,md,scss,css}\" --ignore-path .gitignore",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^20.14.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^5.5.4"
  }
}
