{
  "name": "@lumen/components",
  "version": "0.0.0",
  "description": "Lumen UI 组件库",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./es": "./es/index.mjs",
    "./es/*": "./es/*",
    "./lib": "./lib/index.cjs",
    "./lib/*": "./lib/*"
  },
  "files": [
    "dist",
    "es",
    "lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.config.ts --mode lib",
    "build:lib": "vite build --config vite.config.ts --mode lib",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lumen/tokens": "workspace:*",
    "lucide-vue-next": "^0.542.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "sass": "^1.79.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^2.1.1",
    "vue-tsc": "^2.1.6"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  }
}
